{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "channelscale-yt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "account_id": "2c2214a73eb548b4011bbdb9fe780e71",
  "keep_vars": true,
  "vars": { "INTAKE_WEBHOOK_URL": "https://n8n-production-a00d.up.railway.app/webhook/d9fbe289-a8eb-4236-b47d-99ac3f7d1794" },
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./site/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/portal", "/portal/*", "/login", "/services", "/about", "/about/"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "INQUIRIES", "class_name": "InquiryDelivery" }] },
  "migrations": [{ "tag": "inquiries-v1", "new_sqlite_classes": ["InquiryDelivery"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
